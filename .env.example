# Copy to .env.local and fill in. .env.local is gitignored - never commit it.
#
# Every uncommented NAME=value line here is treated as REQUIRED by
# scripts/pre-deploy.mjs, which fails the deploy if the name is absent from both
# the environment and .env.local. Reading is by name only; values are never read.
#
# Vite exposes only VITE_-prefixed vars to the browser bundle. Anything without
# that prefix is server-side only, which is where every secret below belongs.

# --- required: apps/api ---
# The Postgres the API talks to. Locally, `createdb marble_dev` and point at it.
# In production this is the Supabase connection string.
DATABASE_URL=postgresql://localhost:5432/marble_dev

# --- required: apps/web ---
# Where the browser should send API calls. The two are deployed separately, so
# this is a full origin, not a path. Defaults to the API's dev port when unset.
VITE_API_URL=http://localhost:3001

# --- apps/api (optional) ---
# Origins allowed to send credentialed requests, comma-separated. It cannot be
# '*': browsers reject a wildcard once cookies are in play, and a reflected
# origin would let any site drive the API with a signed-in user's session.
# WEB_ORIGIN=https://marbleapp.vercel.app,http://localhost:5173
#
# PORT=3001
# SESSION_DAYS=7
#
# Object storage for piece photos. Without these the API writes to PHOTO_DIR on
# local disk, which is fine for development and wrong for anything with more
# than one instance. The service-role key bypasses row-level security - it is
# deliberately not VITE_-prefixed and must never reach the browser.
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_PHOTO_BUCKET=piece-photos
# PHOTO_DIR=.data/photos

# --- tests ---
# Postgres the API suite runs against. It is TRUNCATEd between tests, so it must
# never be a database with anything in it you want. Defaults to marble_test on
# the local server.
# TEST_DATABASE_URL=postgresql://localhost:5432/marble_test

# --- @marble/cli (required to run `npm run chat`) ---
# ANTHROPIC_API_KEY=sk-ant-...
#
# Optional: without it the web_search tool says so and the model answers
# from what it already knows rather than pretending to have searched.
# BRAVE_API_KEY=BSA...

# --- analytics (optional) ---
# Project key. VITE_ inlines it into the public bundle, which is correct for a
# write-only project key and would be a disaster for the personal key below.
# VITE_POSTHOG_KEY=phc_...
# VITE_POSTHOG_HOST=https://eu.i.posthog.com
#
# Read-only personal key for @marble/mcp-posthog. NEVER prefix this with VITE_.
# POSTHOG_API_KEY=phx_...
# POSTHOG_PROJECT_ID=12345
