# Copy to .env.local and fill in. .env.local is gitignored - never commit it.
#
# Every uncommented NAME=value line here is treated as REQUIRED by
# scripts/pre-deploy.mjs, which fails the deploy if the name is absent from both
# the environment and .env.local. Reading is by name only; values are never read.
#
# Vite exposes only VITE_-prefixed vars to the browser bundle. Anything without
# that prefix stays server-side, which is where secrets belong once apps/api exists.

# --- required ---
# (none yet - the app runs without any of the below; analytics simply stays off)

# --- @marble/cli (required to run `npm run chat`) ---
# ANTHROPIC_API_KEY=sk-ant-...
#
# Optional: without it the web_search tool says so and the model answers
# from what it already knows rather than pretending to have searched.
# BRAVE_API_KEY=BSA...

# --- analytics (optional) ---
# Project key. VITE_ inlines it into the public bundle, which is correct for a
# write-only project key and would be a disaster for the personal key below.
# VITE_POSTHOG_KEY=phc_...
# VITE_POSTHOG_HOST=https://eu.i.posthog.com
#
# Read-only personal key for @marble/mcp-posthog. NEVER prefix this with VITE_.
# POSTHOG_API_KEY=phx_...
# POSTHOG_PROJECT_ID=12345

# --- coming with apps/api ---
# DATABASE_URL=postgres://localhost:5432/marble
# JWT_SECRET=
